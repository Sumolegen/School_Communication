NODE_ENV=development
PORT=3001
APP_NAME="School Communication"
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_communication?schema=public"

JWT_SECRET="change-this-to-a-long-random-production-secret-key-min-32-chars"
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET="change-this-to-a-long-random-refresh-secret-key-min-32-chars"
JWT_REFRESH_EXPIRES_IN=7d

OTP_EXPIRY_MINUTES=10
OTP_DEV_ECHO=true
MAX_FILE_SIZE_MB=10
UPLOAD_STORAGE_DRIVER=local
UPLOAD_DIR=
